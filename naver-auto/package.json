{
  "name": "naver-auto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "playwright install chromium",
    "dev": "concurrently -n server,ui -c blue,magenta \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "npm run build && cross-env NODE_ENV=production tsx src/server/index.ts",
    "check": "tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts",
    "smoke:ai": "tsx src/scripts/smokeAi.ts",
    "smoke:scrape": "tsx src/scripts/smokeScrape.ts",
    "smoke:collect": "tsx src/scripts/smokeCollect.ts",
    "doctor": "tsx src/scripts/doctor.ts"
  },
  "dependencies": {
    "express": "5.1.0",
    "playwright": "1.56.1"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
